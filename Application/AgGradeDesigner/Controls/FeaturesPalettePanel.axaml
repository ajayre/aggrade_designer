<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgGradeDesigner.ViewModels"
             x:Class="AgGradeDesigner.Controls.FeaturesPalettePanel"
             x:DataType="vm:FeaturesPaletteViewModel"
             ClipToBounds="True"
             Background="{StaticResource AgPanelBrush}"
             Foreground="{StaticResource AgTextPrimaryBrush}">
    <UserControl.Resources>
        <!-- Darkened form of the orange used for a feature that is being created or edited. -->
        <SolidColorBrush x:Key="FeatureEditingRowBrush" Color="#FF4A3014"/>
        <SolidColorBrush x:Key="FeatureEditingRowBorderBrush" Color="#FFF29424"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.feature-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.feature-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="Border.feature-row.alt">
            <Setter Property="Background" Value="{StaticResource AgPanelRaisedBrush}"/>
        </Style>
        <!-- Wins over the stripe so the item being edited is obvious in a long list. -->
        <Style Selector="Border.feature-row.editing">
            <Setter Property="Background" Value="{StaticResource FeatureEditingRowBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FeatureEditingRowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBox.feature-size">
            <Setter Property="Width" Value="72"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource AgPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
        </Style>
        <!-- The text presenter sits at the top of the scroll viewer unless the viewer itself is centered. -->
        <Style Selector="TextBox.feature-size /template/ ScrollViewer">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.feature-size /template/ TextPresenter">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.feature-size:readonly">
            <Setter Property="Background" Value="{StaticResource AgBackgroundBrush}"/>
        </Style>
        <Style Selector="TextBox.feature-coordinate">
            <Setter Property="Width" Value="116"/>
        </Style>
        <Style Selector="TextBox.feature-name">
            <Setter Property="Width" Value="160"/>
        </Style>
        <Style Selector="Button.feature-edit-button">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource AgPanelRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.feature-edit-button /template/ ContentPresenter">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.feature-add-button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{StaticResource AgPanelRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Styles>
    <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="8,4,8,8">
        <TabItem Header="Wells">
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <Button Classes="feature-add-button"
                            Command="{Binding AddWellCommand}"
                            IsEnabled="{Binding CanPlace}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Width="24" Height="24"
                                   Source="avares://AgGradeDesigner/Assets/Icons/well_32px.png"/>
                            <TextBlock Classes="feature-label" Text="Add"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="feature-add-button"
                            Command="{Binding AddWellUsingCoordinatesCommand}"
                            IsEnabled="{Binding CanAddWellByCoordinates}">
                        <TextBlock Classes="feature-label" Text="Add Using Coordinates"/>
                    </Button>
                    <Button Content="Save"
                            Classes="dialog-button primary"
                            Command="{Binding SaveCommand}"
                            IsVisible="{Binding ShowWellSave}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8" IsVisible="{Binding ShowWellSettings}">
                    <TextBlock Classes="feature-label" Text="Diameter"/>
                    <TextBox Classes="feature-size" Text="{Binding WellPadDiameterText}"/>
                    <TextBlock Classes="feature-label" Text="{Binding LengthUnit}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Classes="feature-label" Text="No wells"
                           IsVisible="{Binding !HasWells}" Margin="0,0,0,8"/>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Wells}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WellFeatureRowViewModel">
                                <Border Classes="feature-row"
                                        Classes.alt="{Binding IsAlternate}"
                                        Classes.editing="{Binding IsLiveEdit}">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Classes="feature-label" Text="{Binding CoordinateText}"
                                                   IsVisible="{Binding !ShowDiameter}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowDiameter}">
                                            <TextBlock Classes="feature-label" Text="Latitude"/>
                                            <TextBox Classes="feature-size feature-coordinate"
                                                     Text="{Binding LatitudeText}"
                                                     IsReadOnly="{Binding !CanEditSize}"/>
                                            <TextBlock Classes="feature-label" Text="Longitude"/>
                                            <TextBox Classes="feature-size feature-coordinate"
                                                     Text="{Binding LongitudeText}"
                                                     IsReadOnly="{Binding !CanEditSize}"/>
                                            <TextBlock Classes="feature-label" Text="Diameter"/>
                                            <TextBox Classes="feature-size"
                                                     Text="{Binding PadDiameterText}"
                                                     IsReadOnly="{Binding !CanEditSize}"/>
                                            <TextBlock Classes="feature-label" Text="{Binding LengthUnit}"/>
                                            <Button Classes="feature-edit-button"
                                                    Command="{Binding EditCommand}"
                                                    IsVisible="{Binding ShowEditButton}"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="feature-label" Text="Edit"/>
                                            </Button>
                                            <Button Classes="feature-edit-button"
                                                    Command="{Binding DeleteCommand}"
                                                    IsVisible="{Binding ShowEditButton}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="feature-label" Text="Delete"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
        <TabItem Header="Roads">
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <Button Classes="feature-add-button"
                            Command="{Binding AddRoadCommand}"
                            IsEnabled="{Binding CanPlace}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Width="24" Height="24"
                                   Source="avares://AgGradeDesigner/Assets/Icons/road_32px.png"/>
                            <TextBlock Classes="feature-label" Text="Add"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Save"
                            Classes="dialog-button primary"
                            Command="{Binding SaveCommand}"
                            IsVisible="{Binding ShowRoadSave}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8" IsVisible="{Binding ShowRoadSave}">
                    <TextBlock Classes="feature-label" Text="Road bed width"/>
                    <TextBox Classes="feature-size" Text="{Binding RoadBedWidthText}"/>
                    <TextBlock Classes="feature-label" Text="{Binding LengthUnit}" Margin="0,0,10,0"/>
                    <TextBlock Classes="feature-label" Text="Height"/>
                    <TextBox Classes="feature-size" Text="{Binding RoadHeightText}"/>
                    <TextBlock Classes="feature-label" Text="{Binding LengthUnit}" Margin="0,0,10,0"/>
                    <TextBlock Classes="feature-label" Text="Side slope"/>
                    <TextBox Classes="feature-size" Text="{Binding RoadSideSlopeText}"/>
                    <TextBlock Classes="feature-label" Text=":1"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Classes="feature-label" Text="No roads"
                           IsVisible="{Binding !HasRoads}" Margin="0,0,0,8"/>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Roads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoadFeatureRowViewModel">
                                <Border Classes="feature-row"
                                        Classes.alt="{Binding IsAlternate}"
                                        Classes.editing="{Binding IsLiveEdit}">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Classes="feature-label" Text="{Binding StartText}"/>
                                        <TextBlock Classes="feature-label" Text="{Binding EndText}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowParameters}">
                                            <TextBlock Classes="feature-label" Text="Road bed width"/>
                                            <TextBox Classes="feature-size" Text="{Binding BedWidthText}" IsReadOnly="True"/>
                                            <TextBlock Classes="feature-label" Text="{Binding LengthUnit}" Margin="0,0,10,0"/>
                                            <TextBlock Classes="feature-label" Text="Height"/>
                                            <TextBox Classes="feature-size" Text="{Binding HeightText}" IsReadOnly="True"/>
                                            <TextBlock Classes="feature-label" Text="{Binding LengthUnit}" Margin="0,0,10,0"/>
                                            <TextBlock Classes="feature-label" Text="Side slope"/>
                                            <TextBox Classes="feature-size" Text="{Binding SideSlopeText}" IsReadOnly="True"/>
                                            <TextBlock Classes="feature-label" Text=":1"/>
                                            <Button Classes="feature-edit-button"
                                                    Command="{Binding EditCommand}"
                                                    IsVisible="{Binding ShowEditButton}"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="feature-label" Text="Edit"/>
                                            </Button>
                                            <Button Classes="feature-edit-button"
                                                    Command="{Binding DeleteCommand}"
                                                    IsVisible="{Binding ShowEditButton}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="feature-label" Text="Delete"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
        <TabItem Header="Reference Points">
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <Button Classes="feature-add-button"
                            Command="{Binding AddReferencePointCommand}"
                            IsEnabled="{Binding CanPlace}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Width="24" Height="24"
                                   Source="avares://AgGradeDesigner/Assets/Icons/referencepoint_32px.png"/>
                            <TextBlock Classes="feature-label" Text="Add"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="feature-add-button"
                            Command="{Binding AddReferenceUsingCoordinatesCommand}"
                            IsEnabled="{Binding CanAddReferenceByCoordinates}">
                        <TextBlock Classes="feature-label" Text="Add Using Coordinates"/>
                    </Button>
                    <Button Content="Save"
                            Classes="dialog-button primary"
                            Command="{Binding SaveCommand}"
                            IsVisible="{Binding ShowReferenceSave}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8" IsVisible="{Binding ShowReferenceSettings}">
                    <TextBlock Classes="feature-label" Text="Name"/>
                    <TextBox Classes="feature-size feature-name" Text="{Binding ReferenceNameText}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Classes="feature-label" Text="No reference points"
                           IsVisible="{Binding !HasReferencePoints}" Margin="0,0,0,8"/>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ReferencePoints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReferencePointRowViewModel">
                                <Border Classes="feature-row"
                                        Classes.alt="{Binding IsAlternate}"
                                        Classes.editing="{Binding IsLiveEdit}">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Classes="feature-label" Text="{Binding NameText}"
                                                   IsVisible="{Binding !ShowSettings}"/>
                                        <TextBlock Classes="feature-label" Text="{Binding CoordinateText}"
                                                   IsVisible="{Binding !ShowSettings}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowSettings}">
                                            <TextBlock Classes="feature-label" Text="Name"/>
                                            <TextBox Classes="feature-size feature-name"
                                                     Text="{Binding NameText}"
                                                     IsReadOnly="{Binding !CanEdit}"/>
                                            <TextBlock Classes="feature-label" Text="Latitude"/>
                                            <TextBox Classes="feature-size feature-coordinate"
                                                     Text="{Binding LatitudeText}"
                                                     IsReadOnly="{Binding !CanEdit}"/>
                                            <TextBlock Classes="feature-label" Text="Longitude"/>
                                            <TextBox Classes="feature-size feature-coordinate"
                                                     Text="{Binding LongitudeText}"
                                                     IsReadOnly="{Binding !CanEdit}"/>
                                            <Button Classes="feature-edit-button"
                                                    Command="{Binding EditCommand}"
                                                    IsVisible="{Binding ShowEditButton}"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="feature-label" Text="Edit"/>
                                            </Button>
                                            <Button Classes="feature-edit-button"
                                                    Command="{Binding DeleteCommand}"
                                                    IsVisible="{Binding ShowEditButton}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="feature-label" Text="Delete"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
