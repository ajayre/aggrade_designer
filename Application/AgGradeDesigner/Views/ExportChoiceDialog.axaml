<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgGradeDesigner.ViewModels"
        x:Class="AgGradeDesigner.Views.ExportChoiceDialog"
        x:DataType="vm:ExportChoiceViewModel"
        Title="Export"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AgBackgroundBrush}"
        CanResize="False">
    <Border Padding="20">
        <StackPanel Spacing="12">
            <TextBlock Text="Export from the current project"
                       Foreground="{StaticResource AgTextPrimaryBrush}"/>
            <Button Content="Survey as .ags" Classes="sidebar-button"
                    IsEnabled="{Binding HasSurvey}"
                    Command="{Binding ExportSurveyAgsCommand}"/>
            <Button Content="Survey as Trimble .txt" Classes="sidebar-button"
                    IsEnabled="{Binding HasSurvey}"
                    Command="{Binding ExportSurveyTxtCommand}"/>
            <Button Content="Design as .agd" Classes="sidebar-button"
                    IsEnabled="{Binding HasDesign}"
                    Command="{Binding ExportDesignCommand}"/>
            <Button Content="AgGrade Control (.agcontrol)" Classes="sidebar-button"
                    IsEnabled="{Binding HasDesign}"
                    Command="{Binding ExportAgControlCommand}"/>
            <TextBlock Text="{Binding AgControlDisabledHint}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource AgTextSecondaryBrush}"
                       IsVisible="{Binding !HasDesign}"/>
            <Button Content="Cancel" Classes="dialog-button" HorizontalAlignment="Right" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Border>
</Window>
