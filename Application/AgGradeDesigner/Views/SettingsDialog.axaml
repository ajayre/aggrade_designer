<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgGradeDesigner.ViewModels"
        x:Class="AgGradeDesigner.Views.SettingsDialog"
        x:DataType="vm:SettingsDialogViewModel"
        Title="Settings"
        Width="720"
        Height="640"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AgBackgroundBrush}"
        CanResize="True">
    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="200,*">
            <Border Background="{StaticResource AgPanelBrush}"
                    BorderBrush="{StaticResource AgBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource AgTextPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsSectionItemViewModel">
                                <Button Classes="settings-nav-item"
                                        Classes.active="{Binding IsSelected}"
                                        Command="{Binding SelectCommand}">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="24,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel Spacing="16" VerticalAlignment="Top" IsVisible="{Binding IsAiSectionSelected}">
                        <TextBlock Text="AI" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource AgAccentGreenBrush}"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="AI provider" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <ComboBox ItemsSource="{Binding ProviderOptions}"
                                      SelectedItem="{Binding SelectedProviderOption}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AiProviderOptionViewModel">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding ShowApiKeyField}">
                            <TextBlock Text="API key" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Text="{Binding ApiKey}" PasswordChar="•" PlaceholderText="Enter API key"/>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding ShowNamedProviderModel}">
                            <TextBlock Text="Model (optional)" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Text="{Binding ModelOverride}" PlaceholderText="Leave empty for provider default"/>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding ShowCustomFields}">
                            <TextBlock Text="Base URL" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Text="{Binding CustomBaseUrl}" PlaceholderText="https://api.example.com/v1"/>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding ShowCustomFields}">
                            <TextBlock Text="Model" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Text="{Binding CustomModel}" PlaceholderText="model-id"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="16" VerticalAlignment="Top" IsVisible="{Binding IsUnitsSectionSelected}">
                        <TextBlock Text="Units" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource AgAccentGreenBrush}"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Display units" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <ComboBox ItemsSource="{Binding DisplayUnitOptions}"
                                      SelectedItem="{Binding SelectedDisplayUnitOption}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DisplayUnitOptionViewModel">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8" VerticalAlignment="Top" IsVisible="{Binding IsEquipmentSectionSelected}">
                        <TextBlock Text="Equipment and pass limits" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource AgAccentGreenBrush}" Margin="0,0,0,8"/>
                        <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                            <TextBlock Text="{Binding Equipment.CapacityUnitSuffix, StringFormat=Scraper capacity ({0})}" VerticalAlignment="Center" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Equipment.ScraperCapacityDisplay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                            <TextBlock Text="{Binding Equipment.BladeWidthUnitSuffix, StringFormat=Blade width ({0})}" VerticalAlignment="Center" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Equipment.BladeWidthDisplay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                            <TextBlock Text="{Binding Equipment.DepthUnitSuffix, StringFormat=Max depth per pass ({0})}" VerticalAlignment="Center" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Equipment.MaxDepthDisplay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                            <TextBlock Text="{Binding Equipment.DepthUnitSuffix, StringFormat=Finishing tolerance ({0})}" VerticalAlignment="Center" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Equipment.ToleranceDisplay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                            <TextBlock Text="{Binding Equipment.LengthUnitSuffix, StringFormat=Equipment width ({0})}" VerticalAlignment="Center" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Equipment.EquipmentWidthDisplay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                            <TextBlock Text="{Binding Equipment.LengthUnitSuffix, StringFormat=Equipment length ({0})}" VerticalAlignment="Center" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Equipment.EquipmentLengthDisplay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                            <TextBlock Text="{Binding Equipment.LengthUnitSuffix, StringFormat=Turning diameter ({0})}" VerticalAlignment="Center" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Equipment.TurningCircleDisplay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                            <TextBlock Text="Full-load fuel rate (gal/hr)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Equipment.MaxFuelGalPerHourText}" PlaceholderText="Unset"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                            <TextBlock Text="Maximum drawbar horsepower (hp)" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Equipment.MaxDrawbarHpText}" PlaceholderText="Unset"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                            <TextBlock Text="Minimum work length" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Equipment.EnableMinimumWorkLength}" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                            <TextBlock Text="{Binding Equipment.LengthUnitSuffix, StringFormat=Minimum work length ({0})}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource AgTextPrimaryBrush}" IsEnabled="{Binding Equipment.IsMinimumWorkLengthEnabled}"/>
                            <TextBox Grid.Column="1" Text="{Binding Equipment.MinimumWorkLengthDisplay}" IsEnabled="{Binding Equipment.IsMinimumWorkLengthEnabled}"/>
                        </Grid>
                        <TextBlock Text="Zero uses half the equipment length. Shorter blade-down runs are deferred."
                                   TextWrapping="Wrap" Opacity="0.75" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Spacing="8" VerticalAlignment="Top" IsVisible="{Binding IsDieselSectionSelected}">
                        <TextBlock Text="Diesel" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource AgAccentGreenBrush}" Margin="0,0,0,8"/>
                        <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                            <TextBlock Text="Price per gallon ($)" VerticalAlignment="Center" Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Diesel.PricePerGallonText}" PlaceholderText="Unset"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="16" VerticalAlignment="Top" IsVisible="{Binding IsMiscSectionSelected}">
                        <TextBlock Text="Misc" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource AgAccentGreenBrush}"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Debug Log" VerticalAlignment="Center"
                                       Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding DebugLogEnabled}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="1" Padding="16,12"
                BorderBrush="{StaticResource AgBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Classes="dialog-button" Command="{Binding CancelCommand}"/>
                <Button Content="OK" Classes="dialog-button primary" Command="{Binding OkCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
