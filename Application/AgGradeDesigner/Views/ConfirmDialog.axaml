<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgGradeDesigner.ViewModels"
        x:Class="AgGradeDesigner.Views.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{Binding Title}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AgBackgroundBrush}"
        CanResize="False">
    <Border Padding="20,20,20,16">
        <StackPanel Spacing="16">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                       Foreground="{StaticResource AgTextPrimaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                        IsVisible="{Binding IsQuestion}">
                <Button Content="No" Classes="dialog-button" Command="{Binding NoCommand}"/>
                <Button Content="Yes" Classes="dialog-button primary" Command="{Binding YesCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        IsVisible="{Binding !IsQuestion}">
                <Button Content="OK" Classes="dialog-button primary" Command="{Binding OkCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
