<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock.section-header">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AgAccentGreenBrush}"/>
        <Setter Property="Margin" Value="0,8,0,6"/>
        <Setter Property="LetterSpacing" Value="1"/>
    </Style>

    <Style Selector="Button.toolbar-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.toolbar-button > StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Spacing" Value="2"/>
    </Style>
    <Style Selector="Button.toolbar-button TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button.toolbar-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AgPanelRaisedBrush}"/>
    </Style>
    <Style Selector="Button.toolbar-button:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Image.toolbar-icon">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.sidebar-button">
        <Setter Property="Background" Value="{StaticResource AgPanelRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.sidebar-dialog-button > Grid">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.sidebar-dialog-button TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.sidebar-dialog-button Path">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Image.sidebar-button-icon">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.sidebar-dialog-button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.sidebar-button.active">
        <Setter Property="Background" Value="{StaticResource AgAccentGreenDimBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgAccentGreenBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AgAccentGreenBrush}"/>
    </Style>
    <Style Selector="Button.sidebar-button:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
    </Style>

    <Style Selector="Border.sidebar-panel">
        <Setter Property="Background" Value="{StaticResource AgPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="Border.sidebar-panel-left">
        <Setter Property="MinWidth" Value="154"/>
        <Setter Property="MaxWidth" Value="154"/>
        <Setter Property="Padding" Value="6,8"/>
    </Style>

    <Style Selector="Border.haul-route-scrub-panel">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,8,10,8"/>
    </Style>
    <Style Selector="Border.haul-route-scrub-panel TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>

    <Style Selector="Slider.haul-route-scrub-slider:vertical">
        <Setter Property="MinHeight" Value="160"/>
        <Setter Property="Width" Value="40"/>
    </Style>
    <Style Selector="Slider.haul-route-scrub-slider:vertical /template/ Border#TrackBackground">
        <Setter Property="Background" Value="#A8A8A8"/>
        <Setter Property="Width" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="Slider.haul-route-scrub-slider:vertical /template/ RepeatButton#PART_IncreaseButton Border">
        <Setter Property="Background" Value="#A8A8A8"/>
        <Setter Property="Width" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="Slider.haul-route-scrub-slider:vertical /template/ RepeatButton#PART_DecreaseButton Border">
        <Setter Property="Background" Value="#2196F3"/>
        <Setter Property="Width" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <Style Selector="Button.sidebar-tool-button, ToggleButton.sidebar-tool-button">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{StaticResource AgPanelRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ToggleButton.sidebar-tool-button:checked">
        <Setter Property="Background" Value="{StaticResource AgAccentGreenDimBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgAccentGreenBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AgAccentGreenBrush}"/>
    </Style>
    <Style Selector="Button.sidebar-tool-button:disabled, ToggleButton.sidebar-tool-button:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Image.sidebar-tool-icon">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>
    <Style Selector="ToggleButton.sidebar-tool-button Image.sidebar-tool-icon">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <Style Selector="Grid.sidebar-tool-grid">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="ColumnSpacing" Value="8"/>
        <Setter Property="RowSpacing" Value="8"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style Selector="Border.right-sidebar-panel">
        <Setter Property="Background" Value="{StaticResource AgPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="Image.sidebar-brand-logo">
        <Setter Property="MaxWidth" Value="196"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <Style Selector="Button.dialog-button">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="90"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource AgPanelRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="Button.dialog-button.primary">
        <Setter Property="Background" Value="{StaticResource AgAccentGreenDimBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgAccentGreenBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AgAccentGreenBrush}"/>
    </Style>

    <Style Selector="Button.settings-nav-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.settings-nav-item.active">
        <Setter Property="Background" Value="{StaticResource AgAccentGreenDimBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AgAccentGreenBrush}"/>
    </Style>
    <Style Selector="Button.settings-nav-item:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AgPanelRaisedBrush}"/>
    </Style>
    <Style Selector="Button.settings-nav-item.active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AgAccentGreenDimBrush}"/>
    </Style>
    <Style Selector="Button.settings-nav-item Path">
        <Setter Property="Fill" Value="{StaticResource AgTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.settings-nav-item.active Path">
        <Setter Property="Fill" Value="{StaticResource AgAccentGreenBrush}"/>
    </Style>

    <Style Selector="ContextMenu.context-menu MenuItem">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="Image.context-menu-icon">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</Styles>
