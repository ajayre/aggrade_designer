<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock.section-header">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AgAccentGreenBrush}"/>
        <Setter Property="Margin" Value="0,8,0,6"/>
        <Setter Property="LetterSpacing" Value="1"/>
    </Style>

    <Style Selector="Button.toolbar-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.toolbar-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AgPanelRaisedBrush}"/>
    </Style>
    <Style Selector="Button.toolbar-button:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="ToggleButton.toolbar-view-toggle">
        <Setter Property="Background" Value="{StaticResource AgPanelRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="ToggleButton.toolbar-view-toggle:checked">
        <Setter Property="Background" Value="{StaticResource AgAccentGreenDimBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgAccentGreenBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AgAccentGreenBrush}"/>
    </Style>
    <Style Selector="ToggleButton.toolbar-view-toggle:first-child">
        <Setter Property="CornerRadius" Value="4,0,0,4"/>
    </Style>
    <Style Selector="ToggleButton.toolbar-view-toggle:last-child">
        <Setter Property="CornerRadius" Value="0,4,4,0"/>
        <Setter Property="BorderThickness" Value="1,1,1,1"/>
        <Setter Property="Margin" Value="-1,0,0,0"/>
    </Style>
    <Style Selector="ToggleButton.toolbar-view-toggle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AgPanelBrush}"/>
    </Style>

    <Style Selector="Button.sidebar-button">
        <Setter Property="Background" Value="{StaticResource AgPanelRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.sidebar-dialog-button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.sidebar-button.active">
        <Setter Property="Background" Value="{StaticResource AgAccentGreenDimBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgAccentGreenBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AgAccentGreenBrush}"/>
    </Style>
    <Style Selector="Button.sidebar-button:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
    </Style>

    <Style Selector="Border.sidebar-panel">
        <Setter Property="Background" Value="{StaticResource AgPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="Border.sidebar-panel-left">
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style Selector="Border.right-sidebar-panel">
        <Setter Property="Background" Value="{StaticResource AgPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="Image.sidebar-brand-logo">
        <Setter Property="MaxWidth" Value="196"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <Style Selector="Button.dialog-button">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="90"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource AgPanelRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource AgTextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="Button.dialog-button.primary">
        <Setter Property="Background" Value="{StaticResource AgAccentGreenDimBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgAccentGreenBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AgAccentGreenBrush}"/>
    </Style>

</Styles>
