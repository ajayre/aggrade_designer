<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgGradeDesigner.ViewModels"
        xmlns:controls="using:AgGradeDesigner.Controls"
        xmlns:models="using:AgGradeDesigner.Core.Models"
        x:Class="AgGradeDesigner.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding ProjectTitle}"
        Icon="/Icon/AgGradeDesigner.ico"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        Background="{StaticResource AgBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top toolbar (§7.3) -->
        <Border Grid.Row="0" Background="{StaticResource AgPanelBrush}"
                BorderBrush="{StaticResource AgBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="toolbar-button" Command="{Binding NewProjectCommand}">
                        <StackPanel>
                            <Image Classes="toolbar-icon"
                                   Source="avares://AgGradeDesigner/Assets/Icons/new_48px.png"/>
                            <TextBlock Text="New"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar-button" Command="{Binding OpenProjectCommand}">
                        <StackPanel>
                            <Image Classes="toolbar-icon"
                                   Source="avares://AgGradeDesigner/Assets/Icons/open_48px.png"/>
                            <TextBlock Text="Open"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar-button" Command="{Binding SaveProjectCommand}">
                        <StackPanel>
                            <Image Classes="toolbar-icon"
                                   Source="avares://AgGradeDesigner/Assets/Icons/save_48px.png"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar-button" Command="{Binding SaveProjectAsCommand}">
                        <StackPanel>
                            <Image Classes="toolbar-icon"
                                   Source="avares://AgGradeDesigner/Assets/Icons/saveas_48px.png"/>
                            <TextBlock Text="Save As"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar-button" Command="{Binding ImportCommand}">
                        <StackPanel>
                            <Image Classes="toolbar-icon"
                                   Source="avares://AgGradeDesigner/Assets/Icons/import_48px.png"/>
                            <TextBlock Text="Import"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar-button" Command="{Binding ExportCommand}">
                        <StackPanel>
                            <Image Classes="toolbar-icon"
                                   Source="avares://AgGradeDesigner/Assets/Icons/export_48px.png"/>
                            <TextBlock Text="Export"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="56" Background="{StaticResource AgBorderBrush}" Margin="8,0,4,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton Classes="sidebar-tool-button"
                                      IsChecked="{Binding IsTwoD}"
                                      IsEnabled="{Binding CanSwitchViewerView}">
                            <Image Classes="sidebar-tool-icon"
                                   Source="avares://AgGradeDesigner/Assets/Icons/2d_48px.png"/>
                        </ToggleButton>
                        <ToggleButton Classes="sidebar-tool-button"
                                      IsChecked="{Binding IsThreeD}"
                                      IsEnabled="{Binding CanSwitchToThreeDView}">
                            <Image Classes="sidebar-tool-icon"
                                   Source="avares://AgGradeDesigner/Assets/Icons/3d_48px.png"/>
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ApplicationBranding}" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource AgAccentGoldBrush}" Margin="16,0,22,0"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" ColumnDefinitions="154,*,220">
            <!-- Left sidebar (§7.4) -->
            <Border Grid.Column="0" Classes="sidebar-panel sidebar-panel-left">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Classes="section-header" Text="PROJECT"/>
                            <Button Classes="sidebar-button sidebar-dialog-button"
                                    IsEnabled="{Binding CanOpenSurveyPanel}"
                                    Command="{Binding ShowSurveyStatisticsCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Image Grid.Column="0" Classes="sidebar-button-icon"
                                           Source="avares://AgGradeDesigner/Assets/Icons/survey_32px.png"/>
                                    <TextBlock Grid.Column="1" Text="Survey" HorizontalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M 0,0 L 0,8 L 6,4 Z" Fill="White"
                                          Width="6" Height="8"
                                          Margin="0,0,6,0"/>
                                </Grid>
                            </Button>
                            <Button Classes="sidebar-button sidebar-dialog-button"
                                    IsEnabled="{Binding CanOpenDesignPanel}"
                                    Command="{Binding OpenDesignDialogCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Image Grid.Column="0" Classes="sidebar-button-icon"
                                           Source="avares://AgGradeDesigner/Assets/Icons/design_32px.png"/>
                                    <TextBlock Grid.Column="1" Text="Design" HorizontalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M 0,0 L 0,8 L 6,4 Z" Fill="White"
                                          Width="6" Height="8"
                                          Margin="0,0,6,0"/>
                                </Grid>
                            </Button>
                            <Button Classes="sidebar-button sidebar-dialog-button"
                                    IsEnabled="{Binding CanOpenWaterPanel}"
                                    Command="{Binding OpenWaterDialogCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Image Grid.Column="0" Classes="sidebar-button-icon"
                                           Source="avares://AgGradeDesigner/Assets/Icons/water_48px.png"/>
                                    <TextBlock Grid.Column="1" Text="Water" HorizontalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M 0,0 L 0,8 L 6,4 Z" Fill="White"
                                          Width="6" Height="8"
                                          Margin="0,0,6,0"/>
                                </Grid>
                            </Button>
                            <Button Classes="sidebar-button sidebar-dialog-button"
                                    IsEnabled="{Binding CanOpenHaulPanel}"
                                    Command="{Binding OpenHaulDialogCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Image Grid.Column="0" Classes="sidebar-button-icon"
                                           Source="avares://AgGradeDesigner/Assets/Icons/hauling_32px.png"/>
                                    <TextBlock Grid.Column="1" Text="Haul" HorizontalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M 0,0 L 0,8 L 6,4 Z" Fill="White"
                                          Width="6" Height="8"
                                          Margin="0,0,6,0"/>
                                </Grid>
                            </Button>
                            <Button Classes="sidebar-button sidebar-dialog-button"
                                    Classes.active="{Binding IsAiPanelVisible}"
                                    IsEnabled="{Binding CanOpenAiPanel}"
                                    Command="{Binding ToggleAiPanelCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Image Grid.Column="0" Classes="sidebar-button-icon"
                                           Source="avares://AgGradeDesigner/Assets/Icons/ai_32px.png"/>
                                    <TextBlock Grid.Column="1" Text="AI" HorizontalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M 0,0 L 0,8 L 6,4 Z" Fill="White"
                                          Width="6" Height="8"
                                          Margin="0,0,6,0"/>
                                </Grid>
                            </Button>
                            <Button Classes="sidebar-button sidebar-dialog-button"
                                    IsEnabled="{Binding CanOpenSettingsPanel}"
                                    Command="{Binding OpenSettingsDialogCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Image Grid.Column="0" Classes="sidebar-button-icon"
                                           Source="avares://AgGradeDesigner/Assets/Icons/settings_32px.png"/>
                                    <TextBlock Grid.Column="1" Text="Settings" HorizontalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M 0,0 L 0,8 L 6,4 Z" Fill="White"
                                          Width="6" Height="8"
                                          Margin="0,0,6,0"/>
                                </Grid>
                            </Button>

                            <TextBlock Classes="section-header" Text="TOOLS"/>
                            <Grid Classes="sidebar-tool-grid"
                                  ColumnDefinitions="Auto,Auto"
                                  RowDefinitions="Auto,Auto">
                                <ToggleButton Grid.Row="0" Grid.Column="0" Classes="sidebar-tool-button"
                                              IsChecked="{Binding IsAddPointToolActive, Mode=OneWay}"
                                              Command="{Binding AddPointToolCommand}"
                                              IsEnabled="{Binding CanUseMapTools}">
                                    <Image Classes="sidebar-tool-icon"
                                           Source="avares://AgGradeDesigner/Assets/Icons/addpoint_48px.png"/>
                                </ToggleButton>
                                <ToggleButton Grid.Row="0" Grid.Column="1" Classes="sidebar-tool-button"
                                              IsChecked="{Binding IsAddPolylineToolActive, Mode=OneWay}"
                                              Command="{Binding AddPolylineToolCommand}"
                                              IsEnabled="{Binding CanUseMapTools}">
                                    <Image Classes="sidebar-tool-icon"
                                           Source="avares://AgGradeDesigner/Assets/Icons/addpolyline_48px.png"/>
                                </ToggleButton>
                                <ToggleButton Grid.Row="1" Grid.Column="0" Classes="sidebar-tool-button"
                                              IsChecked="{Binding IsPolygonToolActive, Mode=OneWay}"
                                              Command="{Binding PolygonToolCommand}"
                                              IsEnabled="{Binding CanUseMapTools}">
                                    <Image Classes="sidebar-tool-icon"
                                           Source="avares://AgGradeDesigner/Assets/Icons/polygons_48px.png"/>
                                </ToggleButton>
                                <ToggleButton Grid.Row="1" Grid.Column="1" Classes="sidebar-tool-button"
                                              IsChecked="{Binding IsEraseToolActive, Mode=OneWay}"
                                              Command="{Binding EraseToolCommand}"
                                              IsEnabled="{Binding CanUseMapTools}">
                                    <Image Classes="sidebar-tool-icon"
                                           Source="avares://AgGradeDesigner/Assets/Icons/erase_48px.png"/>
                                </ToggleButton>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Left">
                        <TextBlock Classes="section-header" Text="ELEVATION LEGEND" TextWrapping="NoWrap"
                                   IsVisible="{Binding ShowLegend}"/>
                        <ItemsControl ItemsSource="{Binding LegendBands}" IsVisible="{Binding ShowLegend}"
                                        HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LegendBandViewModel">
                                    <Grid ColumnDefinitions="Auto,Auto" Margin="0,2">
                                        <Border Grid.Column="0" Width="16" Height="16" Background="{Binding Swatch}" CornerRadius="2"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BoundaryText}" Margin="6,0,0,0"
                                                   FontSize="11" VerticalAlignment="Center" TextWrapping="NoWrap"
                                                   Foreground="{StaticResource AgTextSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Central viewer and optional AI chat panel -->
            <Grid Grid.Column="1" IsVisible="{Binding IsAiPanelHidden}">
                <controls:FieldViewerControl x:Name="FieldViewer"
                    IsPresentationActive="{Binding IsAiPanelHidden}"
                    Project="{Binding Project}"
                    ViewMode="{Binding ViewMode}"
                    ContentView="{Binding FieldContentView}"
                    DisplaySettings="{Binding Display}"
                    CentreLatitude="{Binding CentreLat}"
                    CentreLongitude="{Binding CentreLon}"
                    ZoomFactor="{Binding Zoom}"
                    OrbitHeadingDeg="{Binding OrbitHeading}"
                    OrbitPitchDeg="{Binding OrbitPitch}"
                    OrbitDistanceM="{Binding OrbitDistance}"
                    OrbitCentreLatitude="{Binding OrbitCentreLat}"
                    OrbitCentreLongitude="{Binding OrbitCentreLon}"
                    HaulFramePngBytes="{Binding HaulFramePngBytes}"
                    HaulRouteOverlayPngBytes="{Binding HaulRouteOverlayPngBytes}"
                    HaulFieldBoundaryPngBytes="{Binding HaulFieldBoundaryPngBytes}"
                    HaulFieldBoundaryMinLat="{Binding HaulFieldBoundaryMinLat}"
                    HaulFieldBoundaryMaxLat="{Binding HaulFieldBoundaryMaxLat}"
                    HaulFieldBoundaryMinLon="{Binding HaulFieldBoundaryMinLon}"
                    HaulFieldBoundaryMaxLon="{Binding HaulFieldBoundaryMaxLon}"
                    HasHaulFramePlacement="{Binding HasHaulFramePlacement}"
                    HaulFrameMinLat="{Binding HaulFrameMinLat}"
                    HaulFrameMaxLat="{Binding HaulFrameMaxLat}"
                    HaulFrameMinLon="{Binding HaulFrameMinLon}"
                    HaulFrameMaxLon="{Binding HaulFrameMaxLon}"
                    HaulFrameKind="{Binding HaulFrameKind}"
                    HaulThreeDRouteScrubIndex="{Binding HaulThreeDRouteScrubIndex}"
                    HaulRouteScrubIndex="{Binding RouteScrubIndex}"/>
                <Border Background="#CC111111" IsVisible="{Binding IsViewerBusy}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ViewerBusyProgress}"
                                     Width="240" Height="6"/>
                        <TextBlock Text="{Binding ViewerBusyMessage}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AgTextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Background="#CC111111" IsVisible="{Binding IsDesignBusy}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding DesignBusyProgress}"
                                     Width="240" Height="6"/>
                        <TextBlock Text="{Binding DesignBusyMessage}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AgTextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <controls:HaulRouteScrubOverlay x:Name="FullHaulRouteScrubOverlay" DataContext="{Binding}"/>
                <controls:HaulPlanStatisticsOverlay DataContext="{Binding}"/>
            </Grid>

            <Grid Grid.Column="1"
                  ClipToBounds="True"
                  IsVisible="{Binding IsAiPanelVisible}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="180"/>
                </Grid.RowDefinitions>
                <controls:FieldViewerControl x:Name="FieldViewerSplit"
                    Grid.Row="0"
                    MinHeight="120"
                    IsPresentationActive="{Binding IsAiPanelVisible}"
                    Project="{Binding Project}"
                    ViewMode="{Binding ViewMode}"
                    ContentView="{Binding FieldContentView}"
                    DisplaySettings="{Binding Display}"
                    CentreLatitude="{Binding CentreLat}"
                    CentreLongitude="{Binding CentreLon}"
                    ZoomFactor="{Binding Zoom}"
                    OrbitHeadingDeg="{Binding OrbitHeading}"
                    OrbitPitchDeg="{Binding OrbitPitch}"
                    OrbitDistanceM="{Binding OrbitDistance}"
                    OrbitCentreLatitude="{Binding OrbitCentreLat}"
                    OrbitCentreLongitude="{Binding OrbitCentreLon}"
                    HaulFramePngBytes="{Binding HaulFramePngBytes}"
                    HaulRouteOverlayPngBytes="{Binding HaulRouteOverlayPngBytes}"
                    HaulFieldBoundaryPngBytes="{Binding HaulFieldBoundaryPngBytes}"
                    HaulFieldBoundaryMinLat="{Binding HaulFieldBoundaryMinLat}"
                    HaulFieldBoundaryMaxLat="{Binding HaulFieldBoundaryMaxLat}"
                    HaulFieldBoundaryMinLon="{Binding HaulFieldBoundaryMinLon}"
                    HaulFieldBoundaryMaxLon="{Binding HaulFieldBoundaryMaxLon}"
                    HasHaulFramePlacement="{Binding HasHaulFramePlacement}"
                    HaulFrameMinLat="{Binding HaulFrameMinLat}"
                    HaulFrameMaxLat="{Binding HaulFrameMaxLat}"
                    HaulFrameMinLon="{Binding HaulFrameMinLon}"
                    HaulFrameMaxLon="{Binding HaulFrameMaxLon}"
                    HaulFrameKind="{Binding HaulFrameKind}"
                    HaulThreeDRouteScrubIndex="{Binding HaulThreeDRouteScrubIndex}"
                    HaulRouteScrubIndex="{Binding RouteScrubIndex}"/>
                <GridSplitter Grid.Row="1"
                              Height="4"
                              Background="{StaticResource AgBorderBrush}"
                              ResizeDirection="Rows"/>
                <Border Grid.Row="2"
                        MinHeight="180"
                        ClipToBounds="True"
                        ZIndex="1"
                        BorderBrush="{StaticResource AgBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <controls:AiChatPanel VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                          DataContext="{Binding AiChat}"/>
                </Border>
                <Border Grid.Row="0" Background="#CC111111" IsVisible="{Binding IsViewerBusy}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ViewerBusyProgress}"
                                     Width="240" Height="6"/>
                        <TextBlock Text="{Binding ViewerBusyMessage}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AgTextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Background="#CC111111" IsVisible="{Binding IsDesignBusy}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding DesignBusyProgress}"
                                     Width="240" Height="6"/>
                        <TextBlock Text="{Binding DesignBusyMessage}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AgTextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <controls:HaulRouteScrubOverlay x:Name="SplitHaulRouteScrubOverlay" Grid.Row="0" DataContext="{Binding}"/>
                <controls:HaulPlanStatisticsOverlay Grid.Row="0" DataContext="{Binding}"/>
            </Grid>

            <!-- Right sidebar (§7.5) -->
            <Border Grid.Column="2" Classes="right-sidebar-panel">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                        <TextBlock Classes="section-header" Text="VIEW MODE"/>
                        <Button Content="Existing"
                                Classes="sidebar-button"
                                Classes.active="{Binding IsExistingActive}"
                                Command="{Binding SelectExistingCommand}"/>
                        <Button Content="Proposed"
                                Classes="sidebar-button"
                                Classes.active="{Binding IsProposedActive}"
                                Command="{Binding SelectProposedCommand}"/>
                        <Button Content="Cut / Fill"
                                Classes="sidebar-button"
                                Classes.active="{Binding IsCutFillActive}"
                                Command="{Binding SelectCutFillCommand}"/>
                        <Button Content="Haul"
                                Classes="sidebar-button"
                                Classes.active="{Binding IsHaulActive}"
                                IsEnabled="{Binding CanHaulView}"
                                Command="{Binding SelectHaulCommand}"/>

                        <TextBlock Classes="section-header" Text="DISPLAY OPTIONS"/>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Survey Points" VerticalAlignment="Center"
                                       Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding SurveyPointsToggle}" IsEnabled="{Binding SurveyPointsToggleEnabled}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Contours" VerticalAlignment="Center"
                                       Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding ContoursToggle}" IsEnabled="{Binding ContoursToggleEnabled}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Hillshade" VerticalAlignment="Center"
                                       Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding HillshadeToggle}" IsEnabled="{Binding HillshadeToggleEnabled}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Benchmarks" VerticalAlignment="Center"
                                       Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding BenchmarksToggle}" IsEnabled="{Binding BenchmarksToggleEnabled}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Water" VerticalAlignment="Center"
                                       Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <ToggleSwitch Grid.Row="4" Grid.Column="1" IsChecked="{Binding WaterToggle}" IsEnabled="{Binding WaterToggleEnabled}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Haul Flow" VerticalAlignment="Center"
                                       Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <ToggleSwitch Grid.Row="5" Grid.Column="1" IsChecked="{Binding HaulFlowToggle}" IsEnabled="{Binding HaulFlowToggleEnabled}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Satellite" VerticalAlignment="Center"
                                       Foreground="{StaticResource AgTextPrimaryBrush}"/>
                            <ToggleSwitch Grid.Row="6" Grid.Column="1" IsChecked="{Binding SatelliteToggle}" IsEnabled="{Binding HasSurvey}"/>
                        </Grid>

                        <TextBlock Classes="section-header" Text="VERTICAL EXAGGERATION"
                                   IsVisible="{Binding ShowVerticalExaggeration}"/>
                        <Grid IsVisible="{Binding ShowVerticalExaggeration}" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <Slider Grid.Column="0" Minimum="0" Maximum="3" Value="{Binding VerticalExaggeration}" TickFrequency="0.5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding VerticalExaggerationLabel}"
                                       Foreground="{StaticResource AgAccentGreenBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Classes="section-header" Text="OPACITY"
                                   IsVisible="{Binding HasSurvey}"/>
                        <Grid IsVisible="{Binding HasSurvey}" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding TopoCutFillOpacity}" TickFrequency="10" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TopoCutFillOpacityLabel}"
                                       Foreground="{StaticResource AgAccentGreenBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Image Grid.Row="1"
                           Classes="sidebar-brand-logo"
                           Source="avares://AgGradeDesigner/Assets/AgGrade-Logo.png"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,4"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar (§7.6) -->
        <Border Grid.Row="2" Background="{StaticResource AgStatusBarBrush}"
                BorderBrush="{StaticResource AgBorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="24" IsVisible="{Binding HasSurvey}">
                <TextBlock Foreground="{StaticResource AgTextSecondaryBrush}">
                    <Run Text="Lat: "/><Run Text="{Binding StatusLatitude}"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource AgTextSecondaryBrush}">
                    <Run Text="Lon: "/><Run Text="{Binding StatusLongitude}"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource AgTextSecondaryBrush}" Text="{Binding GraphicsRuntimeStatus}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
